#include<stdio.h>
#include<string.h>
void main()
{
    char str[100],ch;
    printf("Enter a string: ");
    scanf("%s",&str);
    printf("Enter a character: ");
    scanf(" %c",&ch);
    for(int i=0;str[i]!='\0';i++)
    {
        if (str[i]==ch)
        {
            printf("%d",i);
        }
    }
}
